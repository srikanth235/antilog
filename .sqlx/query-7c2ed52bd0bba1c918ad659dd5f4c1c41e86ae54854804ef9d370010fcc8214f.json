  "query": "select n.experiment_id, s.session_id, s.kind, coalesce(sum(s.amount_cents), 0)::bigint as \"cents!\", coalesce(sum(s.tokens), 0)::bigint as \"tokens!\" from spend s join sessions n on n.organization_id = s.organization_id and n.id = s.session_id where s.organization_id = $1 and ($2::uuid is null or n.experiment_id = $2) group by n.experiment_id, s.session_id, s.kind order by n.experiment_id, s.session_id, s.kind",
