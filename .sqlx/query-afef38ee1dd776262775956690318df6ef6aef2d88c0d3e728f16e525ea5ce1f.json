  "query": "select v.id, e.archived, v.version, v.name, v.network, v.allowed_hosts, v.allow_package_managers, v.variables, v.setup_script, v.repos, v.network_secrets, v.cpus, v.memory_mb, v.created_by, (extract(epoch from v.created_at) * 1000)::bigint as \"created_at!\"\n               from environment_versions v join environments e on e.organization_id = v.organization_id and e.id = v.id\n               where v.organization_id = $1 and v.id = $2 and v.version = $3",
