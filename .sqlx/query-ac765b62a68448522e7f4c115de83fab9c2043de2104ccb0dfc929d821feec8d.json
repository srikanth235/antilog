{
  "db_name": "PostgreSQL",
  "query": "select n.experiment_id, s.session_id, s.kind, s.amount_cents, (extract(epoch from s.occurred_at) * 1000)::bigint as \"at!\", s.trial_id from spend s join sessions n on n.organization_id = s.organization_id and n.id = s.session_id where s.organization_id = $1 and s.occurred_at >= to_timestamp($2::bigint / 1000.0) and s.occurred_at < to_timestamp($3::bigint / 1000.0) order by s.occurred_at, s.id",
