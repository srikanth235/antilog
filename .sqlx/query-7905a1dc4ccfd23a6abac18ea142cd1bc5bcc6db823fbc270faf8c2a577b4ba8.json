  "query": "select id, organization_id, project_id, title, created_by, agent, model, effort, repos, environment, environment_version, budget_cap_cents, follow_policy, status, note, (extract(epoch from created_at) * 1000)::bigint as \"created_at!\", (extract(epoch from updated_at) * 1000)::bigint as \"updated_at!\" from sessions where organization_id = $1 and ($2::uuid is null or project_id = $2) and ($3::uuid is null or created_by = $3) order by created_at desc, id desc",
