        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "FieldError": {
        "type": "object",
