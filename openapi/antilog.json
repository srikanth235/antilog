{
  "openapi": "3.1.0",
  "info": {
    "title": "Antilog API",
    "description": "",
    "license": {
      "name": "FSL-1.1-ALv2",
      "identifier": "FSL-1.1-ALv2"
    },
    "version": "0.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The server and its store are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The store does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/organizations/{organization}/experiments/{experiment}/sessions": {
      "get": {
        "tags": [],
        "operationId": "sessions",
        "parameters": [
          {
            "name": "organization",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "experiment",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ExperimentId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Session"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [],
        "operationId": "start",
        "parameters": [
          {
            "name": "organization",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "experiment",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ExperimentId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSession"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/organizations/{organization}/experiments/{experiment}/tools/{tool}": {
      "post": {
        "tags": [],
        "operationId": "call",
        "parameters": [
          {
            "name": "organization",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "experiment",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ExperimentId"
            }
          },
          {
            "name": "tool",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolCall"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResult"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/organizations/{organization}/sessions/{session}": {
      "get": {
        "tags": [],
        "operationId": "read",
        "parameters": [
          {
            "name": "organization",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SessionId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/organizations/{organization}/sessions/{session}/messages": {
      "post": {
        "tags": [],
        "operationId": "message",
        "parameters": [
          {
            "name": "organization",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SessionId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/organizations/{organization}/sessions/{session}/step": {
      "post": {
        "tags": [],
        "summary": "The timer's wake-up for a session. At least once, so safe to call again.",
        "operationId": "step",
        "parameters": [
          {
            "name": "organization",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SessionId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StepResult"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/organizations/{organization}/sessions/{session}/stop": {
      "post": {
        "tags": [],
        "operationId": "stop",
        "parameters": [
          {
            "name": "organization",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SessionId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopSession"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/tools": {
      "get": {
        "tags": [],
        "operationId": "tools",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ToolDefinition"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "fields"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Cleanup": {
        "type": "string",
        "enum": [
          "Removed",
          "NotRemoved"
        ]
      },
      "ExperimentId": {
        "type": "string",
        "format": "uuid"
      },
      "FieldError": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "additionalProperties": false
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok"
        ]
      },
      "OrganizationId": {
        "type": "string",
        "format": "uuid"
      },
      "SendMessage": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "description": "One agent's work inside an experiment.",
        "required": [
          "id",
          "organizationId",
          "experimentId",
          "agent",
          "platform",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "agent": {
            "type": "string"
          },
          "cleanup": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Cleanup"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "experimentId": {
            "$ref": "#/components/schemas/ExperimentId"
          },
          "id": {
            "$ref": "#/components/schemas/SessionId"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why it ended, such as \"Stopped by Ada\" or \"Handed off to Codex\"."
          },
          "organizationId": {
            "$ref": "#/components/schemas/OrganizationId"
          },
          "parent": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SessionId",
                "description": "Set on a spawned session; a spawned session cannot spawn."
              },
              {
                "type": "null"
              }
            ]
          },
          "platform": {
            "type": "string"
          },
          "platformHandle": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "SessionId": {
        "type": "string",
        "format": "uuid"
      },
      "SessionStatus": {
        "type": "string",
        "enum": [
          "Working",
          "WaitingForYou",
          "Done",
          "Failed"
        ]
      },
      "StartSession": {
        "type": "object",
        "description": "What starts a session in an experiment.",
        "required": [
          "agent",
          "prompt"
        ],
        "properties": {
          "agent": {
            "type": "string"
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "repos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "StepResult": {
        "type": "object",
        "description": "The result of one relay step.",
        "required": [
          "status",
          "events"
        ],
        "properties": {
          "events": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          }
        },
        "additionalProperties": false
      },
      "StopSession": {
        "type": "object",
        "required": [
          "by"
        ],
        "properties": {
          "by": {
            "type": "string",
            "description": "Shown as \"Stopped by NAME\"."
          }
        },
        "additionalProperties": false
      },
      "ToolCall": {
        "type": "object",
        "description": "A call of one Antilog tool from an agent that is not in a platform session, such as `antilog mcp`.",
        "required": [
          "input"
        ],
        "properties": {
          "call": {
            "type": [
              "string",
              "null"
            ],
            "description": "Unique per call; sending a call again with the same id changes nothing twice."
          },
          "input": {
            "type": "object"
          },
          "session": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SessionId",
                "description": "The session the calls belong to; the first call without one opens it."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "ToolDefinition": {
        "type": "object",
        "required": [
          "name",
          "description",
          "inputSchema"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "inputSchema": {
            "type": "object"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ToolResult": {
        "type": "object",
        "required": [
          "session",
          "answer"
        ],
        "properties": {
          "answer": {
            "type": "object"
          },
          "followup": {
            "type": [
              "string",
              "null"
            ],
            "description": "A measurement that was accepted: how it ended, in words. Never a holdout value."
          },
          "session": {
            "$ref": "#/components/schemas/SessionId"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
