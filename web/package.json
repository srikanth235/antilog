{
  "name": "antilog-web",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "openapi-typescript ../openapi/antilog.json -o src/api/schema.d.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
